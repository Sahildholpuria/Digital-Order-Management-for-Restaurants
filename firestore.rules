rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper to get user document
    function getUserData(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)).data;
    }
    
    // Helper to check user roles
    function hasRole(restaurantId, roles) {
      return isSignedIn() && 
        resourceExists(restaurantId) && 
        getUserData(restaurantId).role in roles;
    }
    
    function resourceExists(restaurantId) {
      return exists(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid));
    }
    
    // Helper to check if user is admin
    function isAdmin(restaurantId) {
      return hasRole(restaurantId, ['admin']);
    }
    
    // Helper to check if user is staff (any role)
    function isStaff(restaurantId) {
      return hasRole(restaurantId, ['admin', 'manager', 'cashier', 'kitchen', 'waiter']);
    }

    // 1. Restaurant SaaS Tenants
    match /restaurants/{restaurantId} {
      allow read: if true; // Publicly readable for customer styling/details
      allow write, update: if isAdmin(restaurantId);
      
      // 2. Staff Accounts
      match /users/{userId} {
        allow read: if isStaff(restaurantId);
        allow write: if isAdmin(restaurantId) || (isSignedIn() && request.auth.uid == userId);
      }
      
      // 3. Tables
      match /tables/{tableId} {
        allow read: if true; // Customers need to see table layout/status
        allow write: if isStaff(restaurantId);
      }
      
      // 4. Menu Categories
      match /categories/{categoryId} {
        allow read: if true; // Public menu categories
        allow write: if hasRole(restaurantId, ['admin', 'manager']);
      }
      
      // 5. Food Items
      match /foodItems/{itemId} {
        allow read: if true; // Public food menu browsing
        allow write: if hasRole(restaurantId, ['admin', 'manager']);
      }
      
      // 6. Orders
      match /orders/{orderId} {
        // Customers can read their specific order or tables can read active orders
        allow read: if true; 
        
        // Anyone can create an order (public checkout flow)
        allow create: if request.resource.data.status == 'pending';
        
        // Only staff can update order statuses or edit details
        allow update: if isStaff(restaurantId);
        allow delete: if isAdmin(restaurantId);
      }
      
      // 7. Payments
      match /payments/{paymentId} {
        allow read, write: if hasRole(restaurantId, ['admin', 'manager', 'cashier']);
      }
      
      // 8. Notifications
      match /notifications/{notificationId} {
        allow create: if true; // Customers can create alerts (call waiter, request bill)
        allow read, update, delete: if isStaff(restaurantId);
      }
    }
  }
}
